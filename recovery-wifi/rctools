#!/sbin/sh
# RCTools - headless recovery control frontend for Motorola Albus.
# Albus is a single-slot (A-only/non-A/B) device with unsuffixed partitions.
# No dependency on the TWRP recovery service.

PATH=/sbin:/system/bin:/system/xbin:/vendor/bin
TMPDIR=/tmp
TMP=/tmp
TEMP=/tmp
export PATH TMPDIR TMP TEMP

BB=/sbin/busybox.albus
NET=/sbin/rctools-net
TIMESYNC=/sbin/recovery-time-sync
DSCHECK=/sbin/ds-recovery-check
MOUNT_TIMEOUT=\${RCTOOLS_MOUNT_TIMEOUT:-8}

say() { printf '%s\n' "$*"; }
err() { printf 'rctools: %s\n' "$*" >&2; }

find_byname_root() {
    for root in \
        /dev/block/bootdevice/by-name \
        /dev/block/platform/soc/7824900.sdhci/by-name
    do
        [ -d "$root" ] && { printf '%s\n' "$root"; return 0; }
    done
    return 1
}

canonical_logical() {
    case "\${1:-}" in
        data|userdata) printf '%s\n' data ;;
        vendor|oem) printf '%s\n' vendor ;;
        firmware|modem) printf '%s\n' firmware ;;
        system|persist|fsg|dsp|cache) printf '%s\n' "$1" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

partition_name() {
    case "\${1:-}" in
        data|userdata) printf '%s\n' userdata ;;
        vendor|oem) printf '%s\n' oem ;;
        firmware|modem) printf '%s\n' modem ;;
        *) printf '%s\n' "$1" ;;
    esac
}

mount_target() {
    case "\${1:-}" in
        data|userdata) printf '%s\n' /data ;;
        system) printf '%s\n' /mnt/system ;;
        vendor|oem) printf '%s\n' /mnt/vendor ;;
        firmware|modem) printf '%s\n' /mnt/vendor/firmware_mnt ;;
        persist) printf '%s\n' /mnt/vendor/persist ;;
        fsg) printf '%s\n' /mnt/vendor/fsg ;;
        dsp) printf '%s\n' /mnt/vendor/dsp ;;
        cache) printf '%s\n' /cache ;;
        *) return 1 ;;
    esac
}

default_mode() {
    case "\${1:-}" in
        firmware|modem|fsg|dsp) printf '%s\n' ro ;;
        *) printf '%s\n' rw ;;
    esac
}

resolve_block() {
    logical="\${1:-}"
    [ -n "$logical" ] || return 1
    root=$(find_byname_root) || return 1
    part=$(partition_name "$logical")
    [ -e "$root/$part" ] || return 1
    printf '%s\n' "$root/$part"
}

mounted_at() {
    "$BB" awk -v m="$1" '$2 == m { found=1 } END { exit found ? 0 : 1 }' /proc/mounts 2>/dev/null
}

mount_one() {
    requested="\${1:-}"
    mode="\${2:-}"
    [ -n "$requested" ] || { err "missing partition name"; return 2; }

    logical=$(canonical_logical "$requested")
    case "$logical" in
        system|vendor|firmware|persist|fsg|dsp|cache|data) ;;
        *)
            err "$requested is not a mountable Albus filesystem; use: rctools block $requested"
            return 2
            ;;
    esac

    [ -n "$mode" ] || mode=$(default_mode "$logical")
    case "$mode" in ro|rw) ;; *) err "mount mode must be ro or rw"; return 2 ;; esac

    dev=$(resolve_block "$logical") || {
        err "partition not found: $requested"
        return 1
    }
    target=$(mount_target "$logical") || return 1

    if mounted_at "$target"; then
        if [ "$mode" = rw ]; then
            "$BB" timeout "$MOUNT_TIMEOUT" "$BB" mount -o remount,rw "$target" >/dev/null 2>&1 || true
        fi
        say "$target is already mounted"
        "$BB" grep " $target " /proc/mounts 2>/dev/null || true
        return 0
    fi

    "$BB" mkdir -p "$target" || return 1

    "$BB" timeout "$MOUNT_TIMEOUT" "$BB" mount -o "$mode" "$dev" "$target" 2>/dev/null || \
    "$BB" timeout "$MOUNT_TIMEOUT" "$BB" mount -t ext4 -o "$mode" "$dev" "$target" 2>/dev/null || \
    "$BB" timeout "$MOUNT_TIMEOUT" "$BB" mount -t f2fs -o "$mode" "$dev" "$target" 2>/dev/null || \
    "$BB" timeout "$MOUNT_TIMEOUT" "$BB" mount -t vfat -o "$mode" "$dev" "$target" 2>/dev/null || {
        err "could not mount $dev at $target as auto/ext4/f2fs/vfat"
        err "use: rctools block $requested"
        return 1
    }

    say "mounted: $logical"
    [ "$requested" = "$logical" ] || say "alias:   $requested -> $logical"
    say "block:   $dev"
    say "target:  $target"
    "$BB" grep " $target " /proc/mounts 2>/dev/null || true
}

umount_one() {
    requested="\${1:-}"
    [ -n "$requested" ] || { err "missing partition name"; return 2; }
    logical=$(canonical_logical "$requested")
    target=$(mount_target "$logical") || {
        err "$requested is not an RCTools filesystem mount"
        return 2
    }

    if ! mounted_at "$target"; then
        say "$target is not mounted"
        return 0
    fi

    "$BB" timeout "$MOUNT_TIMEOUT" "$BB" umount "$target" || return 1
    say "unmounted: $target"
}

mount_group() {
    group="\${1:-all}"
    group_mode="\${2:-}"
    rc=0

    case "$group" in
        common) items="data persist cache" ;;
        system) items="system vendor firmware persist fsg dsp" ;;
        all) items="system vendor firmware persist fsg dsp cache data" ;;
        *) err "unknown mount group: $group"; return 2 ;;
    esac

    for p in $items; do
        if ! resolve_block "$p" >/dev/null 2>&1; then
            say "skip: $p (partition absent)"
            continue
        fi

        mode="$group_mode"
        if [ -z "$mode" ]; then
            mode=$(default_mode "$p")
        elif [ "$p" = firmware ] || [ "$p" = fsg ] || [ "$p" = dsp ]; then
            # Firmware/calibration source partitions remain read-only in group mounts.
            mode=ro
        fi

        mount_one "$p" "$mode" || rc=1
        echo
    done
    return "$rc"
}

show_mounts() {
    printf '%s\n' '--- RCTools Albus mounts ---'
    "$BB" awk '
        $2 == "/data" ||
        $2 == "/cache" ||
        $2 == "/mnt/system" ||
        $2 ~ /^\/mnt\/vendor(\/|$)/ {
            print
        }
    ' /proc/mounts
}

show_partitions() {
    root=$(find_byname_root) || { err "by-name directory not found"; return 1; }
    printf 'by-name: %s\n' "$root"
    "$BB" ls -l "$root" 2>/dev/null
}

show_slot() {
    say "slot mode: single-slot (A-only/non-A/B)"
    say "slot B:    unavailable"
    say "naming:    unsuffixed partitions (system, oem, userdata, modem, persist)"
}

show_block() {
    [ "$#" -ge 1 ] || { err "usage: rctools block NAME"; return 2; }
    logical="$1"

    # Hidden compatibility with older slot-aware scripts. Albus has no slot B.
    case "\${2:-none}" in
        none|active|current|a|_a|"") ;;
        b|_b) err "Albus has no slot B"; return 2 ;;
        *) err "Albus is single-slot; slot argument is not supported"; return 2 ;;
    esac

    dev=$(resolve_block "$logical") || {
        root=$(find_byname_root) || { err "by-name directory not found"; return 1; }
        [ -e "$root/$logical" ] || { err "partition not found: $logical"; return 1; }
        dev="$root/$logical"
    }

    printf '%s\n' "$dev"
    "$BB" ls -l "$dev" 2>/dev/null || true
}

show_info() {
    say "RCTools - Motorola Albus CLI recovery"
    show_slot
    echo
    say "logical vendor -> block oem"
    say "logical firmware -> block modem"
    echo
    show_mounts
    echo
    if [ -x "$NET" ]; then
        "$NET" status 2>/dev/null || true
    else
        say "RCTools network backend: missing"
    fi
}

help_main() {
    printf '%s\n' \
        'RCTools - Motorola Albus CLI recovery' \
        'single-slot / A-only / non-A/B' \
        '' \
        'Core:' \
        '  rctools info' \
        '  rctools slot' \
        '  rctools partitions' \
        '  rctools block NAME' \
        '  rctools mounts' \
        '' \
        'Mounts (Albus unsuffixed partitions):' \
        '  rctools mount system [rw|ro]' \
        '  rctools mount vendor [rw|ro]      # logical vendor -> physical oem' \
        '  rctools mount firmware [ro|rw]    # logical firmware -> physical modem' \
        '  rctools mount persist [rw|ro]' \
        '  rctools mount fsg [ro|rw]' \
        '  rctools mount dsp [ro|rw]' \
        '  rctools mount cache [rw|ro]' \
        '  rctools mount data [rw|ro]        # userdata, normally f2fs' \
        '  rctools mount common [rw|ro]      # data + persist + cache' \
        '  rctools mount all [rw|ro]' \
        '  rctools umount system|vendor|firmware|persist|fsg|dsp|cache|data' \
        '' \
        'Wi-Fi:' \
        '  rctools wifi prepare' \
        '  rctools wifi up' \
        '  rctools wifi start' \
        '  rctools wifi scan' \
        '  rctools wifi connect "SSID" "PASSWORD"' \
        '  rctools wifi connect-sae "SSID" "PASSWORD"' \
        '  rctools wifi connect-open "SSID"' \
        '  rctools wifi networks' \
        '  rctools wifi forget "SSID"' \
        '  rctools wifi forget-all' \
        '  rctools wifi dhcp' \
        '  rctools wifi status' \
        '  rctools wifi ping HOST' \
        '  rctools wifi disconnect' \
        '  rctools wifi down' \
        '  rctools wifi stop' \
        '  rctools wifi logs' \
        '  rctools wifi test' \
        '' \
        'Hotspot / repeater:' \
        '  rctools hotspot create "SSID" "PASSWORD" [CHANNEL]' \
        '  rctools hotspot config' \
        '  rctools hotspot config ssid|password|channel VALUE' \
        '  rctools hotspot delete' \
        '  rctools hotspot start' \
        '  rctools hotspot probe-vif' \
        '  rctools hotspot start-vif ["SSID" "PASSWORD" [CHANNEL]]' \
        '  rctools hotspot repeater ["SSID" "PASSWORD" [CHANNEL]]' \
        '  rctools hotspot repeater-2g ["SSID" "PASSWORD" [CHANNEL]]' \
        '  rctools hotspot repeater-5g ["SSID" "PASSWORD" [CHANNEL]]' \
        '  rctools hotspot status' \
        '  rctools hotspot clients' \
        '  rctools hotspot stop' \
        '' \
        'DroidSpaces / time:' \
        '  rctools droidspaces check' \
        '  rctools time status' \
        '  rctools time sync' \
        '  rctools time restore' \
        '' \
        'RCTools is the single user-facing recovery CLI.'
}

[ -x "$BB" ] || { err "missing BusyBox backend: $BB"; exit 1; }
[ -d /tmp ] || "$BB" mkdir -p /tmp 2>/dev/null || true

cmd="\${1:-help}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
    help|h|-h|--help)
        help_main
        ;;
    info)
        show_info
        ;;
    slot)
        show_slot
        ;;
    partitions)
        show_partitions
        ;;
    block)
        show_block "$@"
        ;;
    mount)
        sub="\${1:-}"
        [ "$#" -gt 0 ] && shift || true
        case "$sub" in
            b|_b)
                err "Albus has no slot B; use unsuffixed mounts such as: rctools mount system"
                exit 2
                ;;
            a|_a|active|current)
                # Compatibility only; Albus is physically single-slot.
                [ "$#" -ge 1 ] || { err "usage: rctools mount $sub PARTITION [rw|ro]"; exit 2; }
                item="$1"; shift
                case "$item" in
                    all|common) mount_group "$item" "\${1:-}" ;;
                    *) mount_one "$item" "\${1:-}" ;;
                esac
                ;;
            all|common)
                mount_group "$sub" "\${1:-}"
                ;;
            system|vendor|oem|firmware|modem|persist|fsg|dsp|cache|data|userdata)
                mount_one "$sub" "\${1:-}"
                ;;
            "")
                err "usage: rctools mount system|vendor|firmware|persist|fsg|dsp|cache|data|common|all [rw|ro]"
                exit 2
                ;;
            *)
                err "$sub is not a mountable Albus filesystem; use rctools block $sub for raw partitions"
                exit 2
                ;;
        esac
        ;;
    umount|unmount)
        sub="\${1:-}"
        [ "$#" -gt 0 ] && shift || true
        case "$sub" in
            b|_b)
                err "Albus has no slot B"
                exit 2
                ;;
            a|_a|active|current)
                [ "$#" -ge 1 ] || { err "usage: rctools umount $sub PARTITION"; exit 2; }
                umount_one "$1"
                ;;
            system|vendor|oem|firmware|modem|persist|fsg|dsp|cache|data|userdata)
                umount_one "$sub"
                ;;
            *)
                err "usage: rctools umount system|vendor|firmware|persist|fsg|dsp|cache|data"
                exit 2
                ;;
        esac
        ;;
    mounts)
        show_mounts
        ;;
    wifi)
        [ -x "$NET" ] || { err "network backend missing: $NET"; exit 1; }
        exec "$NET" "$@"
        ;;
    hotspot)
        [ -x "$NET" ] || { err "network backend missing: $NET"; exit 1; }
        exec "$NET" hotspot "$@"
        ;;
    droidspaces|ds)
        sub="\${1:-check}"
        [ "$#" -gt 0 ] && shift || true
        case "$sub" in
            check) exec "$DSCHECK" "$@" ;;
            *) err "usage: rctools droidspaces check"; exit 2 ;;
        esac
        ;;
    time)
        sub="\${1:-status}"
        [ "$#" -gt 0 ] && shift || true
        case "$sub" in
            status) exec "$TIMESYNC" status ;;
            sync|online) exec "$TIMESYNC" online ;;
            restore) exec "$TIMESYNC" restore ;;
            *) err "usage: rctools time {status|sync|restore}"; exit 2 ;;
        esac
        ;;
    *)
        err "unknown command: $cmd"
        echo
        help_main
        exit 2
        ;;
esac
