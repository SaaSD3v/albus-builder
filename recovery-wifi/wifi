}

cmd_networks() {
    ensure_persistent_store || {
        echo "Persistent Wi-Fi storage unavailable at $WIFI_WLAN_DIR"
        return 1
    }

    count=0
    echo "Saved wlan networks:"
    for saved in "$WIFI_WLAN_NETWORKS"/*.conf; do
        [ -f "$saved" ] || continue
        security=$("$BB" sed -n 's/^# security=//p' "$saved" | "$BB" awk 'NR == 1 { print; exit }')
        ssid=$("$BB" awk '
            /^[[:space:]]*ssid="/ {
                line=$0
                sub(/^[[:space:]]*ssid="/, "", line)
                sub(/"[[:space:]]*$/, "", line)
                print line
                exit
            }
        ' "$saved")
        [ -n "$security" ] || security=UNKNOWN
        [ -n "$ssid" ] || ssid="<unknown>"
        count=$((count + 1))
        printf '%s - [%s] %s\n' "$count" "$security" "$ssid"
    done
    [ "$count" -gt 0 ] || echo "(none)"
}

cmd_forget() {
    [ "$#" -ge 1 ] || {
        echo 'usage: wifi forget "SSID"'
        return 2
    }
    ssid=$1

    ensure_persistent_store || {
        echo "Persistent Wi-Fi storage unavailable at $WIFI_WLAN_DIR"
        return 1
    }

    nid=$(network_id "$ssid") || return 1
    saved="$WIFI_WLAN_NETWORKS/$nid.conf"
    [ -f "$saved" ] || {
        echo "No saved wlan network named: $ssid"
        return 1
    }

    current=$("$WPACLI" -p "$CTRL" -i "$IFACE" status 2>/dev/null | "$BB" sed -n 's/^ssid=//p')
    "$BB" rm -f "$saved" || return 1
    "$BB" sync

    if [ "$current" = "$ssid" ]; then
        cmd_disconnect
    fi

    if ! build_runtime_from_persistent; then
        write_base_conf "$CONF"
    fi
    echo "Forgot wlan network: $ssid"
}

cmd_forget_all() {
    ensure_persistent_store || {
        echo "Persistent Wi-Fi storage unavailable at $WIFI_WLAN_DIR"
        return 1
    }

    "$BB" rm -f "$WIFI_WLAN_NETWORKS"/*.conf 2>/dev/null || true
    "$BB" sync
    cmd_disconnect
    write_base_conf "$CONF"
    echo "Forgot all saved wlan networks."
}

cmd_status() {
    echo "--- driver ---"
    [ -d "/sys/class/net/$IFACE" ] &&
        echo "$IFACE: present" || echo "$IFACE: not present"

    [ -s "$READY" ] &&
        echo "wcnss trigger: complete" || echo "wcnss trigger: not complete"

    echo "--- supplicant ---"
    "$WPACLI" -p "$CTRL" -i "$IFACE" status 2>/dev/null || true

    echo "--- address ---"
    "$BB" ip addr show dev "$IFACE" 2>/dev/null || true

    echo "--- route ---"
    "$BB" ip route 2>/dev/null || true

    echo "--- DNS ---"
    cat /etc/resolv.conf 2>/dev/null || true
}

cmd_disconnect() {
    "$WPACLI" -p "$CTRL" -i "$IFACE" disconnect 2>/dev/null || true
    "$BB" ip addr flush dev "$IFACE" 2>/dev/null || true
    echo "Wi-Fi disconnected"
}

cmd_down() {
    clear_hotspot_state
    stop_supplicant
    "$BB" ip addr flush dev "$IFACE" 2>/dev/null || true
    "$BB" ip link set "$IFACE" down 2>/dev/null || true
    echo "Wi-Fi stopped"
}

cmd_logs() {
    echo "===== recovery Wi-Fi prepare ====="
    cat "$PREPLOG" 2>/dev/null || true

    echo
    echo "===== static WCNSS helper ====="
    cat "$WCNSS_LOG" 2>/dev/null || true

    echo
    echo "===== wpa_supplicant ====="
    "$BB" tail -n 180 "$WPA_LOG" 2>/dev/null || true

    echo
    echo "===== hotspot hostapd ====="
    "$BB" tail -n 180 "$HOTSPOT_LOG" 2>/dev/null || true

    echo
    echo "===== hotspot udhcpd ====="
    "$BB" tail -n 100 "$HOTSPOT_DHCP_LOG" 2>/dev/null || true

    echo
    echo "===== kernel WLAN/WCNSS ====="
    dmesg 2>/dev/null |
        "$BB" grep -iE 'wlan|wcnss|pronto|prima|firmware|cfg80211|rfkill|pil|subsys|softap|concurr|adapter' |
        "$BB" tail -n 240

    echo
    echo "===== mounts ====="
    "$BB" grep -E 'albus-wifi/mnt| /(system|vendor) ' /proc/mounts 2>/dev/null || true

    echo
    echo "===== state ====="
    ls -la "$STATE" "$CTRL" 2>/dev/null || true
}

cmd_test() {
    echo "Albus recovery Wi-Fi validation"

    for f in "$BB" "$WPA" "$WPACLI" "$HOSTAPD" "$IW" "$IPTABLES" "$WCNSS" "$UDHCPC_SCRIPT"; do
        [ -x "$f" ] && echo "OK   $f" || echo "MISS $f"
    done

    for f in         "$VENDOR_BLOCK" "$MODEM_BLOCK" "$PERSIST_BLOCK"         /dev/wcnss_ctrl /dev/wcnss_wlan         "$FIRMWARE_PATH_NODE" "$FWPATH_NODE"; do
        [ -e "$f" ] && echo "OK   $f" || echo "MISS $f"
    done

    echo
    if is_mounted /system; then
        echo "NOTE /system is mounted externally; recovery Wi-Fi does not require it"
    else
        echo "OK   /system remains unmounted"
    fi

    echo
    cmd_status
}

usage() {
    cat <<'EOF'
Recovery Wi-Fi (Motorola albus)

  wifi prepare
  wifi up
  wifi start                         # alias for up
  wifi scan
  wifi connect "SSID" "PASSWORD"       # WPA/WPA2 PSK
  wifi connect-sae "SSID" "PASSWORD"   # WPA3 SAE
  wifi connect-open "SSID"
  wifi networks
  wifi forget "SSID"
  wifi forget-all
  wifi hotspot create "SSID" "PASSWORD" [CHANNEL]    # persist under /data/local/wifi/ap0
  wifi hotspot config                                  # show saved ap0 config
  wifi hotspot config ssid|password|channel VALUE
  wifi hotspot delete
  wifi hotspot probe-vif
  wifi hotspot start-vif ["SSID" "PASSWORD" [CHANNEL]] # AP+STA, no NAT; no args = saved ap0
  wifi hotspot repeater ["SSID" "PASSWORD" [CHANNEL]]  # AP+STA+NAT; no args = saved ap0
  wifi hotspot status
  wifi hotspot clients
  wifi hotspot stop
  wifi dhcp
  wifi status
  wifi ping HOST
  wifi disconnect
  wifi down
  wifi stop                          # alias for down
  wifi logs
  wifi test
  wifi help
EOF
}

mkdir_state
cmd=${1:-help}
shift 2>/dev/null || true

case "$cmd" in
    prepare) prepare ;;
    up|start) cmd_up ;;
    scan) cmd_scan ;;
    connect) cmd_connect "$@" ;;
    connect-sae) cmd_connect_sae "$@" ;;
    connect-open) cmd_connect_open "$@" ;;
    networks) cmd_networks ;;
    forget) cmd_forget "$@" ;;
    forget-all) cmd_forget_all ;;
    hotspot)
        sub=${1:-status}
        [ "$#" -gt 0 ] && shift || true
        case "$sub" in
            create) cmd_hotspot_create "$@" ;;
            config) cmd_hotspot_config "$@" ;;
            delete) cmd_hotspot_delete "$@" ;;
            probe-vif) cmd_hotspot_probe_vif ;;
            start-vif) cmd_hotspot_start_vif "$@" ;;
            repeater) cmd_hotspot_repeater "$@" ;;
            status) cmd_hotspot_status ;;
            clients) cmd_hotspot_clients ;;
            stop) cmd_hotspot_stop ;;
            *)
                echo "Unknown hotspot command: $sub"
                usage
                exit 2
                ;;
        esac
        ;;
    dhcp) do_dhcp ;;
    status) cmd_status ;;
    ping)
        [ "$#" -ge 1 ] || {
            echo 'usage: wifi ping HOST'
            exit 2
        }
        require_payload
        "$BB" ping -c 4 "$1"
        ;;
    disconnect) cmd_disconnect ;;
    down|stop) cmd_down ;;
    logs) cmd_logs ;;
    test) cmd_test ;;
    help|h|-h|--help) usage ;;
    *)
        echo "Unknown command: $cmd"
        usage
        exit 2
        ;;
esac
