#!/sbin/sh
# Recovery Wi-Fi for Motorola albus (MSM8953).
# Hardware bring-up sequence validated on-device in TWRP.

set -u
umask 077

PATH=/sbin:/system/bin:/system/xbin:/vendor/bin:/vendor/bin/hw
export PATH
LC_ALL=C
export LC_ALL

STATE=/tmp/albus-wifi
MNT=$STATE/mnt
FW=$STATE/firmware
LOG=$STATE/wifi.log
WCNSS_LOG=$STATE/wcnss.log
IFACE=${WIFI_IFACE:-wlan0}

VENDOR_BLOCK=/dev/block/bootdevice/by-name/oem
MODEM_BLOCK=/dev/block/bootdevice/by-name/modem

FIRMWARE_PATH_NODE=/sys/module/firmware_class/parameters/path
FWPATH_NODE=/sys/module/wlan/parameters/fwpath

die() {
    echo "wifi: $*" >&2
    exit 1
}

have() {
    command -v "$1" >/dev/null 2>&1
}

ensure_dir() {
    [ -d "$1" ] || mkdir -p "$1" || die "could not create $1"
}

is_mounted() {
    grep -q " $1 " /proc/mounts 2>/dev/null
}

require_root() {
    uid=$(id -u 2>/dev/null || echo 1)
    [ "$uid" = 0 ] || die "run from a root recovery shell"
}

usage() {
    cat <<'EOF'
Albus recovery Wi-Fi
  wifi help       show this help
  wifi test       inspect Wi-Fi prerequisites without starting it
  wifi prepare    stage Albus WCNSS/PRIMA firmware and carrier NV
  wifi up         start WCNSS and bring wlan0 up
  wifi status     show current WCNSS/WLAN state
  wifi down       lower wlan0
  wifi logs       show WCNSS and kernel Wi-Fi logs
EOF
}

print_item() {
    label=$1
    path=$2
    if [ -e "$path" ]; then
        echo "OK   $label: $path"
    else
        echo "MISS $label: $path"
    fi
}

vendor_root() {
    if [ -x /vendor/bin/wcnss_service ]; then
        printf '%s\n' /vendor
        return 0
    fi

    ensure_dir "$MNT/vendor"
    if ! is_mounted "$MNT/vendor"; then
        [ -e "$VENDOR_BLOCK" ] || die "missing vendor/oem block"
        mount -t ext4 -o ro,nosuid,nodev "$VENDOR_BLOCK" "$MNT/vendor" ||
            die "could not mount Albus OEM/vendor"
    fi

    [ -x "$MNT/vendor/bin/wcnss_service" ] ||
        die "wcnss_service not found in Albus vendor"
    printf '%s\n' "$MNT/vendor"
}

mount_modem() {
    ensure_dir "$MNT/modem"
    if ! is_mounted "$MNT/modem"; then
        [ -e "$MODEM_BLOCK" ] || die "missing modem block"
        mount -t ext4 -o ro,nosuid,nodev "$MODEM_BLOCK" "$MNT/modem" ||
            die "could not mount Albus modem firmware"
    fi
}

link_dir_contents() {
    srcdir=$1
    dstdir=$2
    [ -d "$srcdir" ] || return 0
    ensure_dir "$dstdir"

    for src in "$srcdir"/*; do
        [ -e "$src" ] || continue
        base=${src##*/}
        ln -sf "$src" "$dstdir/$base" || return 1
    done
}

select_nv() {
    carrier=$(getprop ro.boot.carrier 2>/dev/null || true)

    case "$carrier" in
        retbr|timbr|tefbr|oibr|amxbr|niibr)
            nv=WCNSS_qcom_wlan_nv_Brazil.bin
            ;;
        perar|retar|tefar|amxar)
            nv=WCNSS_qcom_wlan_nv_Argentina.bin
            ;;
        retin|amzin)
            nv=WCNSS_qcom_wlan_nv_India.bin
            ;;
        *)
            nv=WCNSS_qcom_wlan_nv.bin
            ;;
    esac

    if [ ! -e "$FW/wlan/prima/$nv" ]; then
        nv=WCNSS_qcom_wlan_nv.bin
    fi

    [ -e "$FW/wlan/prima/$nv" ] ||
        die "no usable WCNSS NV file found"

    if [ "$nv" != WCNSS_qcom_wlan_nv.bin ]; then
        ln -sf "$FW/wlan/prima/$nv"             "$FW/wlan/prima/WCNSS_qcom_wlan_nv.bin" ||
            die "could not select regional WCNSS NV"
    fi

    printf '%s\n' "$nv"
}

cmd_test() {
    echo "Albus Wi-Fi prerequisite test"
    print_item "vendor/oem block" "$VENDOR_BLOCK"
    print_item "modem block" "$MODEM_BLOCK"
    print_item "wcnss_ctrl" /dev/wcnss_ctrl
    print_item "wcnss_wlan" /dev/wcnss_wlan
    print_item "firmware_class.path" "$FIRMWARE_PATH_NODE"
    print_item "wlan fwpath" "$FWPATH_NODE"

    echo
    echo "Visible stock payload:"
    if [ -x /vendor/bin/wcnss_service ]; then
        print_item "wcnss_service" /vendor/bin/wcnss_service
        print_item "WCNSS cfg" /vendor/firmware/wlan/prima/WCNSS_qcom_cfg.ini
        print_item "Brazil NV" /vendor/firmware/wlan/prima/WCNSS_qcom_wlan_nv_Brazil.bin
    else
        echo "vendor not mounted; wifi prepare will mount OEM privately"
    fi

    echo
    echo "Interfaces:"
    ls -1 /sys/class/net 2>/dev/null || true
}

cmd_prepare() {
    require_root

    rm -rf "$STATE"
    ensure_dir "$MNT/modem"
    ensure_dir "$MNT/vendor"
    ensure_dir "$FW/wlan/prima"
    : > "$LOG"

    VROOT=$(vendor_root)
    mount_modem

    [ -d "$MNT/modem/image" ] ||
        die "modem image directory is missing"

    link_dir_contents "$MNT/modem/image" "$FW" ||
        die "could not stage modem firmware"
    link_dir_contents "$VROOT/firmware/wlan/prima" "$FW/wlan/prima" ||
        die "could not stage PRIMA firmware"

    if [ -d "$VROOT/etc/wifi" ]; then
        for src in "$VROOT/etc/wifi"/WCNSS_qcom_wlan_nv*.bin; do
            [ -e "$src" ] || continue
            base=${src##*/}
            ln -sf "$src" "$FW/wlan/prima/$base" ||
                die "could not stage $base"
        done
    fi

    if [ ! -e "$FW/wlan/prima/WCNSS_qcom_cfg.ini" ] &&
       [ -s /sbin/albus-WCNSS_qcom_cfg.ini ]; then
        cp /sbin/albus-WCNSS_qcom_cfg.ini             "$FW/wlan/prima/WCNSS_qcom_cfg.ini" ||
            die "could not install WCNSS config fallback"
    fi

    [ -e "$FW/wcnss.mdt" ] ||
        die "wcnss.mdt not found"
    [ -e "$FW/wlan/prima/WCNSS_qcom_cfg.ini" ] ||
        die "WCNSS_qcom_cfg.ini not found"
    [ -e "$FW/wlan/prima/WCNSS_cfg.dat" ] ||
        die "WCNSS_cfg.dat not found"

    nv=$(select_nv)

    [ -w "$FIRMWARE_PATH_NODE" ] ||
        die "firmware_class.path is not writable"
    printf '%s' "$FW" > "$FIRMWARE_PATH_NODE" ||
        die "could not set firmware_class.path"

    {
        echo "vendor_root=$VROOT"
        echo "modem_root=$MNT/modem"
        echo "firmware_path=$FW"
        echo "carrier=$(getprop ro.boot.carrier 2>/dev/null || true)"
        echo "nv_file=$nv"
    } >> "$LOG"

    echo "Albus Wi-Fi firmware prepared."
    echo "vendor: $VROOT"
    echo "firmware: $FW"
    echo "NV: $nv"
}

wcnss_running() {
    ps 2>/dev/null | grep '[w]cnss_service' >/dev/null 2>&1
}

start_wcnss_service() {
    VROOT=$(vendor_root)
    WCNSS_BIN=$VROOT/bin/wcnss_service

    killall wcnss_service 2>/dev/null || true

    ANDROID_ROOT=/system     LD_LIBRARY_PATH="$VROOT/lib64:$VROOT/lib:/system/lib64:/system/lib"     "$WCNSS_BIN" >"$WCNSS_LOG" 2>&1 &

    WCNSSPID=$!
    echo "wcnss_service pid=$WCNSSPID"
    sleep 2

    if ! wcnss_running; then
        echo "wifi: wcnss_service exited" >&2
        cat "$WCNSS_LOG" 2>/dev/null || true
        return 1
    fi

    return 0
}

cmd_up() {
    require_root
    cmd_prepare

    start_wcnss_service ||
        die "could not start wcnss_service"

    [ -w "$FWPATH_NODE" ] ||
        die "wlan fwpath is not writable"

    printf '%s' sta > "$FWPATH_NODE" ||
        die "could not trigger PRONTO WLAN"

    count=0
    while [ "$count" -lt 20 ]; do
        [ -d "/sys/class/net/$IFACE" ] && break
        sleep 1
        count=$((count + 1))
    done

    [ -d "/sys/class/net/$IFACE" ] ||
        die "wlan0 did not appear; run 'wifi logs'"

    if have ip; then
        ip link set "$IFACE" up 2>/dev/null ||
            die "could not bring wlan0 up"
        ip link show "$IFACE" 2>/dev/null || true
    elif have ifconfig; then
        ifconfig "$IFACE" up ||
            die "could not bring wlan0 up"
        ifconfig "$IFACE" 2>/dev/null || true
    else
        die "recovery has neither ip nor ifconfig"
    fi

    echo "Albus Wi-Fi interface $IFACE is ready."
}

cmd_status() {
    echo "Albus recovery Wi-Fi status"

    printf 'firmware_class.path: '
    if [ -r "$FIRMWARE_PATH_NODE" ]; then
        cat "$FIRMWARE_PATH_NODE" 2>/dev/null
        echo
    else
        echo "<unavailable>"
    fi

    printf 'wlan fwpath: '
    if [ -r "$FWPATH_NODE" ]; then
        cat "$FWPATH_NODE" 2>/dev/null
        echo
    else
        echo "<unavailable>"
    fi

    if wcnss_running; then
        echo "wcnss_service: running"
    else
        echo "wcnss_service: not running"
    fi

    if [ -d "/sys/class/net/$IFACE" ]; then
        echo "$IFACE: present"
        if have ip; then
            ip link show "$IFACE" 2>/dev/null || true
            ip addr show "$IFACE" 2>/dev/null || true
        elif have ifconfig; then
            ifconfig "$IFACE" 2>/dev/null || true
        fi
    else
        echo "$IFACE: not present"
    fi
}

cmd_down() {
    require_root

    if [ -d "/sys/class/net/$IFACE" ]; then
        if have ip; then
            ip link set "$IFACE" down 2>/dev/null || true
        elif have ifconfig; then
            ifconfig "$IFACE" down 2>/dev/null || true
        fi
    fi

    killall wcnss_service 2>/dev/null || true
    echo "Albus Wi-Fi stopped."
}

cmd_logs() {
    echo "===== state ====="
    cat "$LOG" 2>/dev/null || true

    echo
    echo "===== wcnss_service ====="
    cat "$WCNSS_LOG" 2>/dev/null || true

    echo
    echo "===== kernel ====="
    dmesg 2>/dev/null |
        grep -iE 'wcnss|wlan|pronto|prima|cfg80211|firmware|pil|subsys' |
        tail -n 300
}

command=${1:-help}
case "$command" in
    help|-h|--help) usage ;;
    test) cmd_test ;;
    prepare) cmd_prepare ;;
    up) cmd_up ;;
    status) cmd_status ;;
    down) cmd_down ;;
    logs) cmd_logs ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
